APP_NAME="Repositorio académico"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Mexico_City
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=repositorio
DB_USERNAME=repositorio
DB_PASSWORD=
DB_SOCKET=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
INSTITUTION_NAME="Tu institución"
INSTITUTION_SHORT_NAME="Institución"
PORTAL_NAME="Repositorio académico"
INSTITUTION_NETWORK=
# Rutas relativas a public/. Archivos privados de cada instalación, fuera de Git.
INSTITUTION_LOGO=
NETWORK_LOGO=
BRAND_PRIMARY="#1B396A"
BRAND_ACCENT="#117533"
ALLOWED_EMAIL_DOMAINS=example.edu
INSTITUTION_PRIVACY_URL=
PRIVACY_CONTACT=
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@example.edu
# Obligatoria para el primer seeder, mínimo 16 caracteres; nunca se sobrescribe una cuenta existente.
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.edu
MAIL_FROM_NAME="${APP_NAME}"

# El comando local usa el MTA instalado. Esta ruta no es editable desde la web.
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
